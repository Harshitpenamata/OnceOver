# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (R2 > Manage API Tokens)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=onceover-files

# Resend (resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL="OnceOver <notifications@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret used to authorize the Vercel Cron cleanup endpoint
CRON_SECRET=

# Only used by scripts/e2e-test.mjs (npm run test:e2e) - not read by the app
# itself. Use a real, deliverable inbox: Resend's sandbox mode restricts
# delivery to the account owner's own address until a sending domain is
# verified. Never commit real values here - .env.local is gitignored, which
# is the whole point of keeping these out of the script.
TEST_EMAIL=
TEST_PASSWORD=
